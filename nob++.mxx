export module nob;

import std;

export namespace nob
{
enum Platform
{
	Linux,
	Windows,
};

enum Compiler
{
	GCC,
	Clang,
	MSVC,
};

enum ExecutionStrategy
{
	System,
	Ninja, // TODO
};

enum WarningLevel
{
	None,
	Default,
	Strict,
	Maximal,
};

enum OptimizationLevel
{
	None,
	CompilerDefault,
	DebugFriendly,
	Size,
	Speed,
	Aggressive,
};

enum RuntimeError
{
	UnrecognizedHostOS,
	NoCompilerFound,
	NoPathEnvVar,
};

std::string getRuntimeErrorMessage(RuntimeError error)
{
	switch (error)
	{
	case RuntimeError::UnrecognizedHostOS:
		return "The host operating system could not be reliably identified "
					 "(checked for Windows and POSIX-like environments).";
	case RuntimeError::NoCompilerFound:
		return "No supported compiler (g++, clang, cl.exe) was found in the system "
					 "PATH.";
	case RuntimeError::NoPathEnvVar:
		return "The system PATH environment variable is not set.";
	default:
		return "Unknown RuntimeError value encountered.";
	}
}

struct BuildResult
{
};
} // namespace nob

namespace nob::detail
{
class BuildCommandGenerator
{
public:
	// This is the common interface for all strategies
	virtual std::vector<std::string>
	generateCommands(const std::string& entry_point, Compiler compiler,
									 Platform os, WarningLevel warning_level,
									 OptimizationLevel optimization_level) const = 0;

	virtual ~BuildCommandGenerator() = default;
};

class SystemCommandGenerator : public BuildCommandGenerator
{
public:
	std::vector<std::string>
	generateCommands(const std::string& entry_point, Compiler compiler,
									 Platform os, WarningLevel warning_level,
									 OptimizationLevel optimization_level) const override
	{
		std::vector<std::string> commands;
		std::string executable_extension = (os == Platform::Windows) ? ".exe" : "";

		if (compiler == Compiler::MSVC)
		{
			std::string optimization_flag;
			if (optimization_level = OptimizationLevel::None)
			{
				optimization_flag = "/Od";
			}
			else if (optimization_level = OptimizationLevel::DebugFriendly)
			{
				optimization_flag = "/Od";
			}
			else if (optimization_level = OptimizationLevel::Size)
			{
				optimization_flag = "/O1";
			}
			else if (optimization_level = OptimizationLevel::Speed)
			{
				optimization_flag = "/O2"
			}
			else if (optimization_level = OptimizationLevel::Aggressive)
			{
				optimization_flag = "/O2";
			}
			else
			{
				optimization_flag = "";
			}

			std::string common_flags = "/std:c++latest /EHsc /nologo /Fe:out";

			commands.push_back(command_exec + common_flags + " " + optimization_flag + " /c" + "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Tools\\MSVC\\14.44.35207\\modules\\std.ixx";

			commands.push_back(command_exec + " " +
								optimization_flag + target_ext + " " + entry_point + " std.obj");
		}
		else if (compiler == Compiler::GCC)
		{
			std::string optimization_flag;
			if (optimization_level = OptimizationLevel::None)
			{
				optimization_flag = "-O0";
			}
			else if (optimization_level = OptimizationLevel::DebugFriendly)
			{
				optimization_flag = "/Og";
			}
			else if (optimization_level = OptimizationLevel::Size)
			{
				optimization_flag = "-Os";
			}
			else if (optimization_level = OptimizationLevel::Speed)
			{
				optimization_flag = "-O2"
			}
			else if (optimization_level = OptimizationLevel::Aggressive)
			{
				optimization_flag = "-O3";
			}
			else
			{
				optimization_flag = "";
			}

			std::string warning_flags;
			if (warning_level == WarningLevel::None)
			{
				warning_flags = "-fsyntax-only";
			}
			else if (warning_level == WarningLevel::Strict)
			{
				warning_flags = "-Wall -Wextra -pedantic";
			}
			else if (warning_level == WarningLevel::Maximal)
			{
				warning_flags =
						"-pedantic -Wall -Wextra -Wcast-align -Wcast-qual "
						"-Wctor-dtor-privacy -Wdisabled-optimization -Wformat=2 "
						"-Winit-self -Wlogical-op -Wmissing-declarations "
						"-Wmissing-include-dirs -Wnoexcept -Wold-style-cast "
						"-Woverloaded-virtual -Wredundant-decls -Wshadow -Wsign-conversion "
						"-Wsign-promo -Wstrict-null-sentinel -Wstrict-overflow=5 "
						"-Wswitch-default -Wundef -Werror -Wno-unused";
			}
			else
			{
				warning_flags = "";
			}

			std::string common_flags = "-std=c++23 -fmodules";

			commands.push_back(
					std::format("g++{} {} {} -fsearch-include-path bits/std.cc "
											"-fmodule-only {} -c bits/std.cc",
											executable_extension, warning_flags, common_flags,
											optimization_flag));

			commands.push_back(std::format("g++{} {} {} {} "
																		 "-o {} -x c++ {}",
																		 executable_extension, warning_flags,
																		 common_flags, optimization_flag, out_file,
																		 entry_point));
		}
	}
};
} // namespace nob::detail

export namespace nob
{
class Builder
{
public:
	Builder(int argc, char* argv[])
	{
		if (std::system("cmd /c ver > nul 2>&1") == 0)
		{
			platform = Platform::Windows;
		}
		else if (std::system("uname > /dev/null 2>&1") == 0)
		{
			platform = Platform::Linux;
		}
		else
		{
			error = RuntimeError::UnrecognizedHostOS;
		}
	}

	Builder& useDefaultArgumentHandling()
	{
		if (error.has_value())
		{
			return *this;
		}
		// TODO: implement some default flags, i.e. -h, -release, -w
		return *this;
	}

	Builder& detectCompiler()
	{
		if (error.has_value())
		{
			return *this;
		}

		return *this;
	}

	Builder& useCompiler(Compiler c)
	{
		if (error.has_value())
		{
			return *this;
		}

		compiler = c;

		return *this;
	}

	Builder& useExecutionStrategy(ExecutionStrategy s)
	{
		if (error.has_value())
		{
			return *this;
		}

		strategy = s;

		return *this;
	}

	Builder& useWarningLevel(WarningLevel l)
	{
		if (error.has_value())
		{
			return *this;
		}

		warning_level = l;

		return *this;
	}

	std::tuple<std::optional<RuntimeError>, BuildResult>
	build(std::string entry_point)
	{
		BuildResult result{};
		if (error.has_value())
		{
			return std::make_tuple(error, result);
		}

		return std::make_tuple(error, result);
	}

private:
	Platform platform;
	Compiler compiler;
	ExecutionStrategy strategy;
	WarningLevel warning_level;
	std::optional<RuntimeError> error;
	std::vector<std::string> args;
};
} // namespace nob
