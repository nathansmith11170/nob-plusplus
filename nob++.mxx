export module nob;

import std;

export namespace nob
{
enum class Platform
{
	Linux,
	Windows,
};

enum class Compiler
{
	GCC,
	Clang,
	MSVC,
};

enum class WarningLevel
{
	None,
	Default,
	Strict,
	Maximal,
};

enum class Standard
{
	Cpp23,
	Cpp26,
};

enum class OptimizationLevel
{
	None,
	CompilerDefault,
	DebugFriendly,
	Size,
	Speed,
	Aggressive,
};

enum class RuntimeError
{
	UnrecognizedHostOS,
	NoCompilerFound,
	NoPathEnvVar,
};

std::string getRuntimeErrorMessage(RuntimeError error)
{
	switch (error)
	{
	case RuntimeError::UnrecognizedHostOS:
		return "The host operating system could not be reliably identified "
					 "(checked for Windows and POSIX-like environments).";
	case RuntimeError::NoCompilerFound:
		return "No supported compiler (g++, clang, cl.exe) was found in the system "
					 "PATH.";
	case RuntimeError::NoPathEnvVar:
		return "The system PATH environment variable is not set.";
	default:
		return "Unknown RuntimeError value encountered.";
	}
}

struct BuildResult
{
};
} // namespace nob

namespace nob::detail
{
class BuildTarget
{
protected:
	std::string getWarningFlags() const
	{
		switch (compiler)
		{
		case Compiler::MSVC:
		{
			switch (warning_level)
			{
			case WarningLevel::None:
			{
				return "/W";
			}
			case WarningLevel::Default:
			{
				return "";
			}
			case WarningLevel::Strict:
			{
				return "/W3";
			}
			case WarningLevel::Maximal:
			{
				return "/W4";
			}
			default:
			{
				return "";
			}
			}
		}
		case Compiler::GCC:
		{
			switch (warning_level)
			{
			case WarningLevel::None:
			{
				return "-w";
			}
			case WarningLevel::Default:
			{
				return "";
			}
			case WarningLevel::Strict:
			{
				return "-Wall -Wextra -Wpedantic";
			}
			case WarningLevel::Maximal:
			{
				return "-pedantic -Wall -Wextra -Wcast-align -Wcast-qual "
							 "-Wctor-dtor-privacy -Wdisabled-optimization -Wformat=2 "
							 "-Winit-self -Wlogical-op -Wmissing-declarations "
							 "-Wmissing-include-dirs -Wnoexcept -Wold-style-cast "
							 "-Woverloaded-virtual -Wredundant-decls -Wshadow "
							 "-Wsign-conversion "
							 "-Wsign-promo -Wstrict-null-sentinel -Wstrict-overflow=5 "
							 "-Wswitch-default -Wundef -Wno-unused";
			}
			default:
			{
				return "";
			}
			}
		}
		case Compiler::Clang:
		{
			switch (warning_level)
			{
			case WarningLevel::None:
			{
				return "-w";
			}
			case WarningLevel::Default:
			{
				return "";
			}
			case WarningLevel::Strict:
			{
				return "-Wall -Wextra -Wpedantic";
			}
			case WarningLevel::Maximal:
			{
				return "-Weverything -Wno-c++98-compat -Wno-padded";
			}
			default:
			{
				return "";
			}
			}
		}
		default:
		{
			return "";
		}
		}
	}

	std::string getOptimizationFlags() const
	{
		switch (compiler)
		{
		case Compiler::MSVC:
		{
			switch (optimization_level)
			{
			case OptimizationLevel::None:
			{
				return "/Od";
			}
			case OptimizationLevel::DebugFriendly:
			{
				return "/Od";
			}
			case OptimizationLevel::Size:
			{
				return "/O1";
			}
			case OptimizationLevel::Speed:
			{
				return "/O2";
			}
			case OptimizationLevel::Aggressive:
			{
				return "/O2";
			}
			default:
			{
				return "";
			}
			}
		}
		case Compiler::GCC:
		case Compiler::Clang:
		{
			switch (optimization_level)
			{
			case OptimizationLevel::None:
			{
				return "-O0";
			}
			case OptimizationLevel::DebugFriendly:
			{
				return "-Og";
			}
			case OptimizationLevel::Size:
			{
				return "-Os";
			}
			case OptimizationLevel::Speed:
			{
				return "-O2";
			}
			case OptimizationLevel::Aggressive:
			{
				return "-O3";
			}
			default:
			{
				return "";
			}
			}
		}
		default:
		{
			return "";
		}
		}
	}

	std::string getStandardFlag() const
	{
		switch (compiler)
		{
		case Compiler::MSVC:
		{
			switch (standard)
			{
			case Standard::Cpp23:
			{
				return "/std:c++23preview";
			}
			case Standard::Cpp26:
			{
				return "/std:c++latest";
			}
			default:
			{
				return "";
			}
			}
		}
		case Compiler::GCC:
		case Compiler::Clang:
		{
			switch (standard)
			{
			case Standard::Cpp23:
			{
				return "-std=c++23";
			}
			case Standard::Cpp26:
			{
				return "-std=c++26";
			}
			default:
			{
				return "";
			}
			}
		}
		default:
		{
			return "";
		}
		}
	}

public:
	// Configuration is now stored in the object
	Compiler compiler;
	Platform os;
	WarningLevel warning_level;
	OptimizationLevel optimization_level;
	Standard standard;

	BuildTarget(Compiler comp, Platform p, WarningLevel wl, OptimizationLevel ol,
							Standard s)
			: compiler(comp), os(p), warning_level(wl), optimization_level(ol),
				standard(s)
	{
	}

	virtual ~BuildTarget() = default;

	virtual std::string getSourcePath() const = 0;

	virtual std::string getObjectFileExtension() const
	{
		if (compiler == Compiler::MSVC)
		{
			return ".obj";
		}
		return ".o";
	}

	virtual std::string
	getObjectFilePath(const std::string& output_dir) const = 0;

	virtual std::string
	getModuleInterfacePath(const std::string& output_dir) const
	{
		return "";
	}

	virtual std::string getModuleName() const { return ""; }

	virtual std::vector<std::string>
	generateCommands(const std::string& output_dir,
									 const std::vector<BuildTarget*>& dependencies) const = 0;
};

// TODO: Module target!

class ExecutableTarget : public BuildTarget
{
public:
	std::string source_path;

	ExecutableTarget(std::string path, Compiler comp, Platform p, WarningLevel wl,
									 OptimizationLevel ol, Standard s)
			: BuildTarget(comp, p, wl, ol, s), source_path(std::move(path))
	{
	}

	std::string getSourcePath() const override { return source_path; }

	std::string getObjectFilePath(const std::string& output_dir) const override
	{
		return (std::filesystem::path(output_dir) /
						std::filesystem::path(source_path).filename())
				.replace_extension(getObjectFileExtension())
				.string();
	}

	std::vector<std::string>
	generateCommands(const std::string& output_dir,
									 const std::vector<BuildTarget*>& dependencies) const override
	{
		std::vector<std::string> commands;
		const std::string own_object_file = getObjectFilePath(output_dir);
		std::string executable_extension = (os == Platform::Windows) ? ".exe" : "";

		if (compiler == Compiler::MSVC)
		{
			std::string compile_command = "cl.exe " + getStandardFlag() +
																		" /EHsc /nologo " + getWarningFlags() +
																		" " + getOptimizationFlags() + " /c ";
			compile_command += "/Fo:\"" + own_object_file + "\" ";
			compile_command += "\"" + getSourcePath() + "\" ";

			for (const auto* dep : dependencies)
			{
				std::string ifc_path = dep->getModuleInterfacePath(output_dir);
				if (!ifc_path.empty())
				{
					compile_command +=
							"/reference " + dep->getModuleName() + "=\"" + ifc_path + "\" ";
				}
			}
			commands.push_back(compile_command);
		}
		else if (compiler == Compiler::GCC)
		{
			std::string compile_command =
					"g++" + executable_extension + " " + getStandardFlag() + " " +
					getWarningFlags() + " " + getOptimizationFlags() + " -fmodules -c ";
			compile_command += "-o \"" + own_object_file + "\" ";
			compile_command += "\"" + getSourcePath() + "\" ";

			// For GCC, we just need to tell it where to find the compiled module
			// files It automatically maps module names to file paths in that
			// directory.
			compile_command +=
					"-fmodule-path=" + std::filesystem::path(output_dir).string() +
					"/gcm.cache/ ";

			commands.push_back(compile_command);
		}
		else if (compiler == Compiler::Clang)
		{
			std::string compile_command = "clang++" + executable_extension +
																		" -stdlib=libc++ " + getStandardFlag() +
																		" " + getWarningFlags() + " " +
																		getOptimizationFlags() + " -c ";
			compile_command += "-o \"" + own_object_file + "\" ";
			compile_command += "\"" + getSourcePath() + "\" ";

			for (const auto* dep : dependencies)
			{
				// ex. -fmodule-file=foo="out/foo.pcm" "src/foo.mxx"
				compile_command += "-fmodule-file=" + dep->getModuleName() + "=\"" +
													 dep->getModuleInterfacePath(output_dir) + "\" \"" +
													 dep->getSourcePath() + "\" ";
			}

			commands.push_back(compile_command);
		}

		// --- Part 2: LINK all object files into the final executable ---
		std::filesystem::path out_file =
				std::filesystem::path(getSourcePath()).filename();
		std::filesystem::path output_executable = output_dir / out_file;
		output_executable.replace_extension(executable_extension);

		if (compiler == Compiler::MSVC)
		{
			std::string link_command = "link.exe /nologo ";
			link_command += "/OUT:\"" + output_executable.string() + "\" ";
			link_command += "\"" + own_object_file + "\" "; // Add own object file

			for (const auto* dep : dependencies)
			{
				link_command += "\"" + dep->getObjectFilePath(output_dir) + "\" ";
			}
			commands.push_back(link_command);
		}
		else if (compiler == Compiler::GCC)
		{
			// With GCC, it's often easiest to use the g++ driver for linking
			std::string link_command =
					"g++" + executable_extension + " " + getStandardFlag() + " ";
			link_command += "-o \"" + output_executable.string() + "\" ";
			link_command += "\"" + own_object_file + "\" "; // Add own object file

			for (const auto* dep : dependencies)
			{
				link_command += "\"" + dep->getObjectFilePath(output_dir) + "\" ";
			}
			commands.push_back(link_command);
		}
		else if (compiler == Compiler::Clang)
		{
			std::string link_command = "clang++" + executable_extension +
																 " -stdlib=libc++ " + getStandardFlag() + " ";
			link_command += "-o \"" + output_executable.string() + "\" ";
			link_command += "\"" + own_object_file + "\" ";

			for (const auto* dep : dependencies)
			{
				link_command += "\"" + dep->getObjectFilePath(output_dir) + "\" ";
			}
			commands.push_back(link_command);
		}

		return commands;
	}
};

class SystemCommandGenerator
{
public:
	std::vector<std::string>
	generateCommands(const std::string& entry_point,
									 const std::string& output_dir, Compiler compiler,
									 Platform os, WarningLevel warning_level,
									 OptimizationLevel optimization_level) const
	{
		// Orchestrate the build:
		// Use the compiler to scan dependencies
		// Parse the resulting JSON P1689R5 (will require a JSON parser
		// implementation in nob::detail) Construct the directed acyclic graph of
		// build targets 		Emit error if cycle detected Spawn the build processes
		// to construct the project Emit warnings and errors
		return std::vector<std::string>();
	}
};
} // namespace nob::detail

export namespace nob
{
class Builder
{
public:
	Builder(int argc, char* argv[])
	{
		if (std::system("cmd /c ver > nul 2>&1") == 0)
		{
			platform = Platform::Windows;
		}
		else if (std::system("uname > /dev/null 2>&1") == 0)
		{
			platform = Platform::Linux;
		}
		else
		{
			error = RuntimeError::UnrecognizedHostOS;
		}
	}

	Builder& useDefaultArgumentHandling()
	{
		if (error.has_value())
		{
			return *this;
		}
		// TODO: implement some default flags, i.e. -h, -release, -w
		return *this;
	}

	Builder& detectCompiler()
	{
		if (error.has_value())
		{
			return *this;
		}

		return *this;
	}

	Builder& useCompiler(Compiler c)
	{
		if (error.has_value())
		{
			return *this;
		}

		compiler = c;

		return *this;
	}

	Builder& useWarningLevel(WarningLevel l)
	{
		if (error.has_value())
		{
			return *this;
		}

		warning_level = l;

		return *this;
	}

	std::tuple<std::optional<RuntimeError>, BuildResult>
	buildExe(std::string entry_point)
	{
		BuildResult result{};
		if (error.has_value())
		{
			return std::make_tuple(error, result);
		}

		return std::make_tuple(error, result);
	}

private:
	Platform platform;
	Compiler compiler;
	WarningLevel warning_level;
	std::optional<RuntimeError> error;
	std::vector<std::string> args;
};
} // namespace nob
